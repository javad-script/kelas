generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMINISTRATIVE_STAFF
  MANAGEMENT_STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolType {
  PUBLIC
  PRIVATE
}
enum Grade {
  ELEMENTARY
  MIDDLE
  HIGH
}

model School {
  id         Int         @id @default(autoincrement())
  name       String
  phoneNumber String  @unique
  email       String?  @unique
  about       String? 
  website     String?  @unique
  address     String?
  type        SchoolType?
  gradeLevel  Grade?
  establishedYear Int?
  logo        String?
  bannerImage String?
  totalClasses Int?

  users      User[]
  classRooms ClassRoom[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("schools")
}

model User {
  id            Int      @id @default(autoincrement())
  profileImage  String?  
  firstName     String
  lastName      String
  username      String   @unique
  phone         String   @unique
  email         String   @unique
  nationalCode  String   @unique
  password      String
  role          Role

  // کلاس‌هایی که معلم درس میده
  teachingAssignments ClassTeacher[] @relation("TeacherAssignment")

  // حضور غیاب دانش‌آموز
  attendanceRecords AttendanceStudent[]

  // School relation
  schoolId      Int?
  school        School?   @relation(fields: [schoolId], references: [id])

  // Parent ↔ Child (self relation)
  parentId      Int?
  parent        User?    @relation("ParentRelation", fields: [parentId], references: [id])
  children      User[]   @relation("ParentRelation")

  // کلاس‌هایی که دانش‌آموز در آن‌ها ثبت‌نام شده
  studentClasses ClassRoom[] @relation("StudentClasses")

  // Optional personal info
  birthDate      DateTime?
  address        String?
  housePhone     String?
  emergencyPhone String?

  // Father info
  fatherPhone       String?
  fatherEmail       String?
  fatherJob         String?
  fatherJobAddress  String?
  fatherJobPhone    String?

  // Mother info
  motherPhone       String?
  motherEmail       String?
  motherJob         String?
  motherJobAddress  String?
  motherJobPhone    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
  @@map("users")
}

model ClassRoom {
  id        Int      @id @default(autoincrement())
  name      String
  grade     Int

  attendance  Attendance[]

  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])

  students  User[]  @relation("StudentClasses")
  teacherAssignments ClassTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("class_rooms")
}

model ClassTeacher {
  id        Int @id @default(autoincrement())

  teacherId Int
  classId   Int

  // Relation به معلم
  teacher   User      @relation("TeacherAssignment", fields: [teacherId], references: [id])
  // Relation به کلاس
  classRoom ClassRoom @relation(fields: [classId], references: [id])

  // حضور غیاب‌های این معلم و کلاس
  attendances Attendance[] @relation("TeacherAttendance")

  @@unique([teacherId, classId])
  @@map("class_teachers")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime

  classId   Int
  classRoom ClassRoom @relation(fields: [classId], references: [id])

  classTeacherId Int?
  classTeacher   ClassTeacher? @relation("TeacherAttendance", fields: [classTeacherId], references: [id])

  students  AttendanceStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@map("attendance")
}

model AttendanceStudent {
  id           Int @id @default(autoincrement())

  attendanceId Int
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  studentId    Int
  student      User       @relation(fields: [studentId], references: [id])

  status       AttendanceStatus
  lateMinutes  Int?
  note         String?

  @@unique([attendanceId, studentId])
  @@index([studentId])
  @@map("attendance_student")
}

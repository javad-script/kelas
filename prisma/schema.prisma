generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WeekDays{
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMINISTRATIVE_STAFF
  MANAGEMENT_STAFF
}

enum UserAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
enum AttendanceStatus{
  MOVAJAH
  QERMOVAJAH
}

enum SchoolType {
  PUBLIC
  PRIVATE
}
enum Grade {
  ELEMENTARY
  MIDDLE
  HIGH
}

model School {
  id         String         @id @default(cuid())
  name       String
  phoneNumber String  @unique
  email       String?  @unique
  about       String? 
  website     String?  @unique
  address     String?
  type        SchoolType?
  gradeLevel  Grade?
  establishedYear Int?
  logo        String?
  totalClasses Int?

  members      SchoolUser[]
  classRooms ClassRoom[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("schools")
}

model User {
  id            String      @id @default(cuid())
  profileImage  String?  
  firstName     String
  lastName      String
  username      String   @unique
  phone         String   @unique
  email         String   @unique
  nationalCode  String   @unique
  password      String
  role          Role


  // حضور غیاب دانش‌آموز
  attendanceRecords AttendanceStudent[]

  schoolMemberships SchoolUser[]

  // Parent ↔ Child (self relation)
  parentId      String?
  parent        User?    @relation("ParentRelation", fields: [parentId], references: [id])
  children      User[]   @relation("ParentRelation")

  // کلاس‌هایی که دانش‌آموز در آن‌ها ثبت‌نام شده
  studentClasses StudentClass[] 
  teacherLessons LessonClass[]

  attendances Attendance[]

  // Optional personal info
  birthDate      DateTime?
  address        String?
  housePhone     String?
  emergencyPhone String?

  // Father info
  fatherPhone       String?
  fatherEmail       String?
  fatherJob         String?
  fatherJobAddress  String?
  fatherJobPhone    String?

  // Mother info
  motherPhone       String?
  motherEmail       String?
  motherJob         String?
  motherJobAddress  String?
  motherJobPhone    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@map("users")
}
model SchoolUser {
  id       Int    @id @default(autoincrement())

  userId   String
  schoolId String

  user     User   @relation(fields: [userId], references: [id])
  school   School @relation(fields: [schoolId], references: [id])

  role     Role

  @@unique([userId, schoolId])
  @@map("school_users")
}

model StudentClass{
  id      Int     @id @default(autoincrement())
  studentId String 
  classId   String

  student   User  @relation(fields: [studentId] , references: [id])
  class   ClassRoom  @relation(fields: [classId] , references: [id])
  @@unique([studentId,classId])
  @@map("student_classes")
}

model ClassRoom {
  id        String      @id @default(cuid())
  name      String
  grade     Int

  attendance  Attendance[]

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])

  studentClass  StudentClass[]
  lessonClass LessonClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("class_rooms")
}

model Attendance {
  id             String            @id @default(cuid())
  date           DateTime          @db.Date          // فقط تاریخ (بدون ساعت)

  classId        String
  classRoom      ClassRoom         @relation(fields: [classId], references: [id], onDelete: Cascade)

  lessonClassId       Int
  lessonClass    LessonClass       @relation(fields: [lessonClassId],references: [id])

  students       AttendanceStudent[]

  schoolPeriod  Int

  teacherId String
  teacher User @relation(fields: [teacherId],references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([classId,date,lessonClassId,schoolPeriod])
  @@index([classId, date])
  @@map("attendance")
}

model AttendanceStudent {
  id             String           @id @default(cuid())

  attendanceId   String
  attendance     Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  studentId      String
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

userStatus    UserAttendanceStatus
  status         AttendanceStatus
  lateMinutes    Int?             
  note           String?          @db.Text

  @@unique([attendanceId, studentId])  // جلوگیری از تکراری دانشجو در یک حضورغیاب
  @@index([studentId])
  @@map("attendance_student")
}


model Lesson{
  id    Int   @id @default(autoincrement())
  name  String @unique
  image String

  classes LessonClass[]

  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  
  @@index([name])
  @@map("lesson")
}

model LessonClass{
  id    Int   @id @default(autoincrement())

  lessonId  Int
  lesson  Lesson @relation(fields: [lessonId],references: [id])

  teacherId String
  teacher User  @relation(fields: [teacherId],references: [id])

  classId String
  class ClassRoom @relation(fields: [classId] , references: [id])

  attendance  Attendance[]

  schoolPeriod  Int

  weekDay WeekDays

  startTime DateTime
  endTime   DateTime

  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  @@unique([schoolPeriod,weekDay,classId])
  @@index([lessonId,teacherId,classId])
  @@map("lesson_class")
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMINISTRATIVE_STAFF
  MANAGEMENT_STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolType {
  PUBLIC
  PRIVATE
}
enum Grade {
  ELEMENTARY
  MIDDLE
  HIGH
}

model School {
  id         String         @id @default(cuid())
  name       String
  phoneNumber String  @unique
  email       String?  @unique
  about       String? 
  website     String?  @unique
  address     String?
  type        SchoolType?
  gradeLevel  Grade?
  establishedYear Int?
  logo        String?
  totalClasses Int?

  members      SchoolUser[]
  classRooms ClassRoom[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("schools")
}

model User {
  id            String      @id @default(cuid())
  profileImage  String?  
  firstName     String
  lastName      String
  username      String   @unique
  phone         String   @unique
  email         String   @unique
  nationalCode  String   @unique
  password      String
  role          Role

  // کلاس‌هایی که معلم درس میده
  teachingAssignments ClassTeacher[] @relation("TeacherAssignment")

  // حضور غیاب دانش‌آموز
  attendanceRecords AttendanceStudent[]

  schoolMemberships SchoolUser[]

  // Parent ↔ Child (self relation)
  parentId      String?
  parent        User?    @relation("ParentRelation", fields: [parentId], references: [id])
  children      User[]   @relation("ParentRelation")

  // کلاس‌هایی که دانش‌آموز در آن‌ها ثبت‌نام شده
  studentClasses StudentClass[] 

  // Optional personal info
  birthDate      DateTime?
  address        String?
  housePhone     String?
  emergencyPhone String?

  // Father info
  fatherPhone       String?
  fatherEmail       String?
  fatherJob         String?
  fatherJobAddress  String?
  fatherJobPhone    String?

  // Mother info
  motherPhone       String?
  motherEmail       String?
  motherJob         String?
  motherJobAddress  String?
  motherJobPhone    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@map("users")
}
model SchoolUser {
  id       Int    @id @default(autoincrement())

  userId   String
  schoolId String

  user     User   @relation(fields: [userId], references: [id])
  school   School @relation(fields: [schoolId], references: [id])

  role     Role

  @@unique([userId, schoolId])
  @@map("school_users")
}

model StudentClass{
  id      Int     @id @default(autoincrement())
  studentId String 
  classId   String

  student   User  @relation(fields: [studentId] , references: [id])
  class   ClassRoom  @relation(fields: [classId] , references: [id])
  @@unique([studentId,classId])
  @@map("student_classes")
}

model ClassRoom {
  id        String      @id @default(cuid())
  name      String
  grade     Int

  attendance  Attendance[]

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])

  studentClass  StudentClass[]
  teacherAssignments ClassTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("class_rooms")
}

model ClassTeacher {
  id        Int @id @default(autoincrement())

  teacherId String
  classId   String

  // Relation به معلم
  teacher   User      @relation("TeacherAssignment", fields: [teacherId], references: [id])
  // Relation به کلاس
  classRoom ClassRoom @relation(fields: [classId], references: [id])

  // حضور غیاب‌های این معلم و کلاس
  attendances Attendance[] @relation("TeacherAttendance")

  @@unique([teacherId, classId])
  @@map("class_teachers")
}

model Attendance {
  id        String      @id @default(cuid())
  date      DateTime

  classId   String
  classRoom ClassRoom @relation(fields: [classId], references: [id])

  classTeacherId Int?
  classTeacher   ClassTeacher? @relation("TeacherAttendance", fields: [classTeacherId], references: [id])

  students  AttendanceStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@map("attendance")
}

model AttendanceStudent {
  id           String @id @default(cuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  studentId    String
  student      User       @relation(fields: [studentId], references: [id])

  status       AttendanceStatus
  lateMinutes  Int?
  note         String?

  @@unique([attendanceId, studentId])
  @@index([studentId])
  @@map("attendance_student")
}
